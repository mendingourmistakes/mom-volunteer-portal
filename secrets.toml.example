# M.O.M. Volunteer Portal - Streamlit Secrets Template
# Copy these contents into your Streamlit Cloud Secrets Manager (Settings -> Secrets)

[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID_HERE/edit"
# If your sheet is public (Anyone with link can Edit), no service account is needed!
# If your sheet is private, add your Service Account JSON credentials below:
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "your-key-id"
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "your-service-account@your-project.iam.gserviceaccount.com"
